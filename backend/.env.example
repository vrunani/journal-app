# From the OAuth client JSON you downloaded in Google Cloud Console
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Desktop app redirect - do not change
GOOGLE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# Filled in after running `npm run get-token` (see scripts/getRefreshToken.js)
GOOGLE_REFRESH_TOKEN=

# The Gmail address you're sending FROM (the "sender" account you authenticated as above)
SENDER_EMAIL=your-sender-account@gmail.com

# The Gmail address the letters go TO
RECEIVER_EMAIL=your-receiver-account@gmail.com

# Google Drive folder ID where letters are stored.
# Create a folder in the sender account's Drive, open it, copy the ID from the URL
# (drive.google.com/drive/folders/<THIS PART>), and paste it here.
DRIVE_FOLDER_ID=

PORT=4000
